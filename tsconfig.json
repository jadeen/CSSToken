{
  "compilerOptions": {
    "target": "esnext",
    "module": "NodeNext",
    "outDir": "./dist",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
  },
  "include": ["src/index.ts"],
  "exclude": ["node_modules"]
}